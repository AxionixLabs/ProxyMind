{
  "description": "End-to-end coverage for all supported hook events",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import json,sys; json.load(sys.stdin); print('{}')\"",
            "statusMessage": "E2E PreToolUse",
            "timeout": 3,
            "async": false
          }
        ]
      }
    ],
