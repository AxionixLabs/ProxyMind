{
  "name": "@craftline/workspace",
  "private": true,
  "description": "Craftline Mind npm workspace.",
  "type": "module",
  "workspaces": [
    "packages/mind",
    "packages/mind-win32",
    "packages/mind-darwin"
  ],
  "scripts": {
    "sync:applications": "node ./scripts/sync-applications.js",
    "check": "node --check ./packages/mind/bin/mind.js",
    "dry:mind": "npm publish -w @craftline/mind --dry-run --access public",
    "dry:win32": "npm publish -w @craftline/mind-win32 --dry-run --access public",
    "dry:darwin": "npm publish -w @craftline/mind-darwin --dry-run --access public"
  }
}
